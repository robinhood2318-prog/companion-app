<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <EditText
        android:id="@+id/et_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="What do you need to do?"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="80" />

    <TextView
        style="@style/DialogLabel"
        android:text="Priority" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_new_priority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkedChip="@+id/chip_new_medium"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_new_high"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_new_medium"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medium" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_new_low"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
