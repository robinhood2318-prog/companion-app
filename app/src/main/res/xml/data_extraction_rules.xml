<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep all personal data (tasks, alarms, steps, app list) out of cloud backup
     and device-to-device transfer, matching android:allowBackup="false" on older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
